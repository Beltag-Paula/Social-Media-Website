<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
    <%- include('partials/nav', { active: 'admin', showAdminLink: true, nonce }) %>

    <div class="page">
        <h1 class="rainbow-text">Control Panel ⚙</h1>

        <div class="module field-block">
            <div class="module-title">Pending</div>
            <div class="module-body" id="pendingUsers"></div>
        </div>

        <div class="module blue field-block">
            <div class="module-title">Active</div>
            <div class="module-body" id="activeUsers"></div>
        </div>

        <div class="module pink field-block">
            <div class="module-title">Banned</div>
            <div class="module-body" id="bannedUsers"></div>
        </div>

        <div class="module field-block">
            <div class="module-title">Security Audit Log</div>
            <div class="module-body">
                <p class="gallery-hint">Failed logins, account lockouts, and every ban/approve/delete action — who did what, and when.</p>
                <div id="auditLog"><p class="no-comments">Loading...</p></div>
            </div>
        </div>

        <button type="button" id="myProfileButton">Go to my profile</button>
        <button type="button" class="ghost logout-btn">Log out</button>
    </div>

    <%- include('partials/lightbox', { nonce }) %>
    <%- include('partials/chatWidget', { nonce }) %>
    <%- include('partials/chatSidebar', { nonce }) %>

    <script nonce="<%= nonce %>">
        // Containers
        const activeContainer = document.getElementById("activeUsers");
        const bannedContainer = document.getElementById("bannedUsers");
        const pendingContainer = document.getElementById("pendingUsers");

        document.querySelectorAll(".logout-btn").forEach(btn => {
            btn.addEventListener("click", async () => {
                await fetch("/api/v1/logout", { method: "POST", credentials: "include" });
                window.location.href = "/";
            });
        });

        document.getElementById("myProfileButton").addEventListener("click", () => {
            window.location.href = "/profile";
        });

        const STATUS_LABEL = { 0: "pending", 1: "active", 2: "banned" };

        function renderUser(parent, user) {
            const row = document.createElement("div");
            row.className = "user-row";
            row.id = `user-${user.id}`;

            const name = document.createElement("p");
            name.className = "username";
            name.textContent = user.username;

            const statusTag = document.createElement("span");
            const statusKey = STATUS_LABEL[user.status] || "pending";
            statusTag.className = `stamp ${statusKey}`;
            statusTag.textContent = statusKey;

            row.appendChild(name);
            row.appendChild(statusTag);

            if (user.banReason) {
                const reasonText = document.createElement("p");
                reasonText.className = "ban-reason";
                reasonText.textContent = `Reason: ${user.banReason}`;
                row.appendChild(reasonText);
            }

            const statusSelect = document.createElement("select");
            statusSelect.innerHTML = `
                <option value="" disabled selected>Change status</option>
                <option value="1">Active</option>
                <option value="2">Banned</option>
                <option value="0">Pending</option>
            `;

            statusSelect.onchange = async (e) => {
                const newStatus = e.target.value;
                let banReason = null;

                if (newStatus == "2") {
                    banReason = prompt("Enter ban reason:");
                }

                await updateStatus(user.id, newStatus, banReason);
            };

            const deleteBtn = document.createElement("button");
            deleteBtn.className = "danger";
            deleteBtn.textContent = "Delete";
            deleteBtn.onclick = () => deleteUser(user.id);

            row.appendChild(statusSelect);

            // Messaging only makes sense once someone's actually a member —
            // for a pending signup there's nothing to discuss yet (that's
            // what the status dropdown + ban reason are for), and for a
            // banned account DMing them isn't the appeal channel this app
            // has. Keeping it scoped to active users avoids a "why would I
            // message someone who just signed up?" button on every row.
            if (user.status === 1) {
                const messageBtn = document.createElement("button");
                messageBtn.className = "ghost";
                messageBtn.textContent = "Message";
                messageBtn.onclick = () => {
                    if (typeof window.openChatWith === "function") {
                        window.openChatWith(user.id, user.username);
                    }
                };
                row.appendChild(messageBtn);
            }

            row.appendChild(deleteBtn);

            parent.appendChild(row);
        }

        async function loadSection(endpoint, container) {
            try {
                const response = await fetch(`/api/v1/admin/users/${endpoint}`, {
                    credentials: "include"
                });

                if (response.status === 401 || response.status === 403) {
                    window.location.href = "/";
                    return;
                }

                const data = await response.json();
                container.innerHTML = "";

                if (data.rows && Array.isArray(data.rows)) {
                    if (data.rows.length === 0) {
                        container.innerHTML = "<p class='no-comments'>Nobody here.</p>";
                        return;
                    }
                    data.rows.forEach(user => renderUser(container, user));
                }
            } catch (err) {
                console.error("Error loading " + endpoint, err);
            }
        }

        async function deleteUser(id) {
            if (!confirm("Delete user?")) return;

            try {
                const res = await fetch("/api/v1/admin/users/delete", {
                    method: "DELETE",
                    credentials: "include",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ id })
                });

                const data = await res.json();

                if (!res.ok) {
                    alert(data.message);
                    return;
                }

                alert(data.message);
                refreshAll();

            } catch (err) {
                console.error(err);
                alert("Network error");
            }
        }

        async function updateStatus(id, status, banReason = null) {
            const res = await fetch("/api/v1/admin/users/status", {
                method: "PATCH",
                credentials: "include",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id, status, banReason })
            });

            const data = await res.json();

            if (!res.ok) {
                alert(data.message);
                return;
            }

            refreshAll();
        }

        function refreshAll() {
            loadSection("active", activeContainer);
            loadSection("pending", pendingContainer);
            loadSection("banned", bannedContainer);
        }

        async function executeGlobalSearch() {
            const q = document.getElementById("globalSearchInput").value;
            const res = await fetch(`/api/v1/search?username=${encodeURIComponent(q)}`, {
                credentials: "include"
            });
            const users = await res.json();
            const resultsDiv = document.getElementById("globalSearchResults");
            resultsDiv.innerHTML = "";

            users.forEach(u => {
                const p = document.createElement("p");
                const a = document.createElement("a");
                a.href = `/profile?id=${encodeURIComponent(u.id)}`;
                a.textContent = u.username;
                p.appendChild(a);
                resultsDiv.appendChild(p);
            });
        }

        refreshAll();

        // ===== SECURITY AUDIT LOG =====
        const EVENT_LABEL = {
            login_success: "Login succeeded",
            login_failed: "Login failed",
            login_failed_unknown_user: "Login failed (unknown user)",
            login_blocked_locked: "Login blocked (account locked)",
            account_locked: "Account locked",
            signup: "New signup",
            signup_failed_duplicate: "Signup failed (username taken)",
            admin_ban_user: "Admin banned a user",
            admin_approve_user: "Admin approved a user",
            admin_set_pending: "Admin set a user to pending",
            admin_delete_user: "Admin deleted a user",
        };

        // Rendered with textContent throughout — audit rows can contain
        // attacker-supplied usernames (e.g. a failed-login attempt against
        // a name someone just typed in), so this can never be innerHTML.
        function renderAuditRow(entry) {
            const row = document.createElement("div");
            row.className = "audit-row";

            const label = document.createElement("span");
            label.className = "audit-event";
            label.textContent = EVENT_LABEL[entry.eventType] || entry.eventType;
            row.appendChild(label);

            const who = document.createElement("span");
            who.className = "audit-who";
            let whoText = entry.actorUsername || (entry.details ? "" : "unknown");
            if (entry.targetUsername) whoText += ` → ${entry.targetUsername}`;
            who.textContent = whoText;
            row.appendChild(who);

            if (entry.details) {
                try {
                    const parsed = JSON.parse(entry.details);
                    if (parsed.username && !entry.actorUsername) {
                        who.textContent = parsed.username + (whoText ? ` ${whoText}` : "");
                    }
                    if (parsed.banReason) {
                        const reason = document.createElement("span");
                        reason.className = "audit-detail";
                        reason.textContent = `"${parsed.banReason}"`;
                        row.appendChild(reason);
                    }
                } catch (e) { /* details wasn't JSON — ignore */ }
            }

            const ip = document.createElement("span");
            ip.className = "audit-ip";
            ip.textContent = entry.ip || "";
            row.appendChild(ip);

            const time = document.createElement("span");
            time.className = "audit-time";
            time.textContent = new Date(entry.createdAt.replace(" ", "T") + "Z").toLocaleString();
            row.appendChild(time);

            return row;
        }

        async function loadAuditLog() {
            const container = document.getElementById("auditLog");
            try {
                const res = await fetch("/api/v1/admin/audit-log?limit=50", { credentials: "include" });
                if (!res.ok) return;
                const entries = await res.json();
                container.innerHTML = "";

                if (!Array.isArray(entries) || entries.length === 0) {
                    container.innerHTML = "<p class='no-comments'>No events recorded yet.</p>";
                    return;
                }

                entries.forEach(e => container.appendChild(renderAuditRow(e)));
            } catch (e) {
                container.innerHTML = "<p class='no-comments'>Couldn't load the audit log.</p>";
            }
        }

        loadAuditLog();
    </script>

    <%- include('partials/fx', { nonce }) %>

</body>

</html>
