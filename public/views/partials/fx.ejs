<canvas id="particleCanvas" aria-hidden="true"></canvas>

<script nonce="<%= nonce %>">
  (function () {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    window.__fx = window.__fx || {};
    window.__fx.prefersReducedMotion = prefersReducedMotion;

    const CIPHER_CHARS = "!<>-_\\/[]{}=+*^?#$%01アイウエオ";

    function decryptReveal(el, { duration = 900, delay = 0 } = {}, onDone) {
      if (!el) return;
      const finalChars = Array.from(el.textContent);
      const finalText = finalChars.join("");

      if (prefersReducedMotion) {
        el.textContent = finalText;
        el.setAttribute("data-text", finalText);
        if (onDone) onDone();
        return;
      }

      el.setAttribute("data-text", finalText);
      let startTime = null;

      function frame(ts) {
        if (startTime === null) startTime = ts;
        const progress = Math.min((ts - startTime) / duration, 1);
        const revealCount = Math.floor(progress * finalChars.length);

        el.textContent = finalChars
          .map((ch, i) => {
            if (i < revealCount || ch === " ") return ch;
            return CIPHER_CHARS[Math.floor(Math.random() * CIPHER_CHARS.length)];
          })
          .join("");

        if (progress < 1) {
          requestAnimationFrame(frame);
        } else {
          el.textContent = finalText;
          if (onDone) onDone();
        }
      }

      setTimeout(() => requestAnimationFrame(frame), delay);
    }
    window.__fx.decryptReveal = decryptReveal;

    function startGlitch(el) {
      if (!el || prefersReducedMotion) return;
      el.classList.add("glitch");

      function scheduleNext() {
        const wait = 3500 + Math.random() * 4000;
        setTimeout(() => {
          el.classList.add("glitch-active");
          setTimeout(() => el.classList.remove("glitch-active"), 260);
          scheduleNext();
        }, wait);
      }
      scheduleNext();
    }
    window.__fx.startGlitch = startGlitch;

    const titleEl = document.querySelector("h1.rainbow-text");
    const moduleTitleEls = document.querySelectorAll(".module-title");

    if (titleEl) {
      decryptReveal(titleEl, { duration: 900, delay: 100 }, () => startGlitch(titleEl));
    }
    moduleTitleEls.forEach((el, i) => {
      decryptReveal(el, { duration: 650, delay: 300 + i * 150 });
    });

    const particleCanvas = document.getElementById("particleCanvas");
    if (!particleCanvas || !particleCanvas.getContext) return;

    const pctx = particleCanvas.getContext("2d");
    const PARTICLE_RGB = "102, 192, 244";

    let pW = 0, pH = 0, particles = [];

    function spawnParticle(randomY) {
      return {
        x: Math.random() * pW,
        y: randomY ? Math.random() * pH : pH + 10,
        r: 1 + Math.random() * 2,
        vy: 0.15 + Math.random() * 0.35,
        sway: Math.random() * Math.PI * 2,
        swaySpeed: 0.002 + Math.random() * 0.004,
        alpha: 0.15 + Math.random() * 0.4,
      };
    }

    function resizeParticles() {
      pW = particleCanvas.width = window.innerWidth;
      pH = particleCanvas.height = window.innerHeight;
      const count = Math.min(70, Math.floor((pW * pH) / 18000));
      particles = new Array(count).fill(0).map(() => spawnParticle(true));
    }

    function drawParticles(scrollOffset) {
      pctx.clearRect(0, 0, pW, pH);
      for (const p of particles) {
        p.y -= p.vy;
        p.sway += p.swaySpeed;
        if (p.y < -10) Object.assign(p, spawnParticle(false));

        const x = p.x + Math.sin(p.sway) * 8;
        const y = p.y + scrollOffset * 0.06;

        pctx.beginPath();
        pctx.fillStyle = `rgba(${PARTICLE_RGB}, ${p.alpha})`;
        pctx.arc(x, y, p.r, 0, Math.PI * 2);
        pctx.fill();
      }
    }

    let particleRaf = null;
    function particleLoop() {
      drawParticles(window.scrollY || 0);
      particleRaf = requestAnimationFrame(particleLoop);
    }
    function startParticles() {
      if (particleRaf === null) particleRaf = requestAnimationFrame(particleLoop);
    }
    function stopParticles() {
      if (particleRaf !== null) {
        cancelAnimationFrame(particleRaf);
        particleRaf = null;
      }
    }

    resizeParticles();
    window.addEventListener("resize", resizeParticles);

    if (!prefersReducedMotion) {
      startParticles();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stopParticles();
        else startParticles();
      });
    } else {
      drawParticles(0);
    }
  })();
</script>
