<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <%- include('partials/nav', { active: 'home', showAdminLink: false, nonce }) %>

  <div class="page">
    <h1 class="rainbow-text">Latest Posts</h1>

    <div class="module pink">
      <div class="module-title">What's on your mind?</div>
      <div class="module-body">
        <form id="newPostForm" class="new-post-form">
          <div class="row">
            <label for="postTitle">Title</label>
            <input type="text" id="postTitle" placeholder="Give it a title..." maxlength="255">
          </div>
          <div class="row">
            <label for="postBody">Post</label>
            <textarea id="postBody" placeholder="Say something..."></textarea>
          </div>
          <div class="row">
            <label for="postMedia">Attach a pic or video (optional)</label>
            <div class="upload-control">
              <div class="dropzone" id="postMediaDropzone" tabindex="0" role="button" aria-label="Attach a photo or video">
                <span class="dropzone-icon">+</span>
                <p class="dropzone-text">Drag &amp; drop a photo or video, or click to browse</p>
                <p class="dropzone-filename" id="postMediaFilename"></p>
              </div>
              <input type="file" id="postMedia" accept="image/*,video/*" class="visually-hidden">
            </div>
          </div>
          <button type="submit" class="pink">Post it! <span class="new-badge blink">NEW</span></button>
        </form>
      </div>
    </div>

    <div id="feedContainer">
      <p class="loading-text">Loading posts...</p>
    </div>
  </div>

  <%- include('partials/dropzone', { nonce }) %>
  <%- include('partials/lightbox', { nonce }) %>
  <%- include('partials/chatWidget', { nonce }) %>
  <%- include('partials/chatSidebar', { nonce }) %>

  <script nonce="<%= nonce %>">
    const API = "/api/v1";

    // Same reasoning as profile.ejs's copy of this: a DB reference to a
    // media file doesn't guarantee the file is actually still on disk, and
    // without this a missing one rendered as raw alt text instead of
    // failing gracefully. Property assignment (not inline onerror="") so
    // it isn't blocked by the CSP in server.js the way inline attributes are.
    function withImageFallback(imgEl, fallbackSrc) {
      imgEl.onerror = function () {
        imgEl.onerror = null;
        imgEl.src = fallbackSrc;
      };
    }

    // ===== WHO AM I (drives the admin nav link) =====
    async function loadMe() {
      try {
        const res = await fetch(`${API}/me`, { credentials: "include" });
        if (!res.ok) return;
        const me = await res.json();
        if (me.isAdmin) document.getElementById("adminNavLink").classList.remove("hidden");
      } catch (e) { /* not logged in, nav link just stays hidden */ }
    }

    // ===== FEED =====
    // Kept in sync with what's on screen so post images can open the
    // shared lightbox with working Prev/Next across the whole feed.
    let currentFeedImages = [];

    async function loadFeed() {
      const res = await fetch(`${API}/feed`, { credentials: "include" });

      if (res.status === 401 || res.status === 403) {
        window.location.href = "/";
        return;
      }

      const posts = await res.json();
      const container = document.getElementById("feedContainer");
      container.innerHTML = "";

      if (!Array.isArray(posts) || posts.length === 0) {
        container.innerHTML = "<p class='loading-text'>No posts yet — be the first!</p>";
        return;
      }

      currentFeedImages = posts
        .filter(p => p.mediaPath && !/\.(mp4|webm|mov)$/i.test(p.mediaPath))
        .map(p => ({ src: `/${p.mediaPath}`, caption: p.title ? `${p.username} — ${p.title}` : p.username }));

      let imageIndex = 0;
      posts.forEach(post => {
        const isImage = post.mediaPath && !/\.(mp4|webm|mov)$/i.test(post.mediaPath);
        container.appendChild(renderPost(post, isImage ? imageIndex : -1));
        if (isImage) imageIndex++;
      });
    }

    // Built with createElement + textContent (not innerHTML) so a post
    // body or username can never inject a script into the page.
    function renderPost(post, imageIndex) {
      const card = document.createElement("div");
      card.className = "module post-module";

      const titleBar = document.createElement("div");
      titleBar.className = "module-title";
      if (post.avatarPath) {
        const avatar = document.createElement("img");
        avatar.className = "mini-avatar";
        withImageFallback(avatar, "/default-avatar.svg");
        avatar.src = `/${post.avatarPath}`;
        avatar.alt = "";
        titleBar.appendChild(avatar);
      }
      const nameSpan = document.createElement("span");
      nameSpan.textContent = post.title ? `${post.username} — ${post.title}` : post.username;
      titleBar.appendChild(nameSpan);

      // A quick way into a DM with the poster, right from their post.
      if (typeof window.openChatWith === "function") {
        const msgBtn = document.createElement("button");
        msgBtn.type = "button";
        msgBtn.className = "ghost post-message-btn";
        msgBtn.textContent = "💬";
        msgBtn.title = `Message ${post.username}`;
        msgBtn.addEventListener("click", () => window.openChatWith(post.userId, post.username));
        titleBar.appendChild(msgBtn);
      }

      card.appendChild(titleBar);

      const body = document.createElement("div");
      body.className = "module-body";

      if (post.body) {
        const bodyP = document.createElement("p");
        bodyP.className = "post-body";
        bodyP.textContent = post.body;
        body.appendChild(bodyP);
      }

      if (post.mediaPath) {
        const isVideo = /\.(mp4|webm|mov)$/i.test(post.mediaPath);
        const media = document.createElement(isVideo ? "video" : "img");
        media.className = "post-media";
        if (!isVideo) withImageFallback(media, "/default-image.svg");
        media.src = `/${post.mediaPath}`;
        if (isVideo) {
          media.controls = true;
        } else {
          media.alt = "";
          media.style.cursor = "zoom-in";
          media.addEventListener("click", () => {
            window.__lightbox.open(currentFeedImages, imageIndex);
          });
        }
        body.appendChild(media);
      }

      const meta = document.createElement("small");
      meta.className = "post-meta";
      meta.textContent = new Date(post.createdAt).toLocaleString();
      body.appendChild(meta);

      // ----- actions: like + comment toggle -----
      const actionBar = document.createElement("div");
      actionBar.className = "action-bar";

      const likeBtn = document.createElement("button");
      likeBtn.className = "like-btn" + (post.likedByMe ? " liked" : "");
      likeBtn.textContent = `♥ ${post.likeCount || 0}`;
      likeBtn.onclick = async () => {
        const res = await fetch(`${API}/like`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ postId: post.postId })
        });
        const data = await res.json();
        const current = parseInt(likeBtn.textContent.replace("♥", "").trim(), 10) || 0;
        const nextCount = data.liked ? current + 1 : Math.max(current - 1, 0);
        likeBtn.textContent = `♥ ${nextCount}`;
        likeBtn.classList.toggle("liked", data.liked);
      };
      actionBar.appendChild(likeBtn);

      const commentToggle = document.createElement("button");
      commentToggle.className = "ghost";
      commentToggle.textContent = `💬 ${post.commentCount || 0} comments`;
      body.appendChild(actionBar);
      body.appendChild(commentToggle);

      // ----- comments box (built once, shown/hidden + lazy loaded) -----
      const commentsBox = document.createElement("div");
      commentsBox.className = "comments-box";
      commentsBox.style.display = "none";

      const commentsHeading = document.createElement("h4");
      commentsHeading.textContent = "Comments";
      commentsBox.appendChild(commentsHeading);

      const commentsList = document.createElement("div");
      commentsBox.appendChild(commentsList);

      const commentForm = document.createElement("form");
      commentForm.className = "comment-form";
      const commentInput = document.createElement("input");
      commentInput.type = "text";
      commentInput.placeholder = "Write a comment...";
      commentInput.maxLength = 500;
      const commentSubmit = document.createElement("button");
      commentSubmit.type = "submit";
      commentSubmit.textContent = "Post";
      commentForm.appendChild(commentInput);
      commentForm.appendChild(commentSubmit);
      commentsBox.appendChild(commentForm);

      let loaded = false;
      async function loadComments() {
        const res = await fetch(`${API}/comments/${post.postId}`, { credentials: "include" });
        const comments = await res.json();
        commentsList.innerHTML = "";

        if (!Array.isArray(comments) || comments.length === 0) {
          const none = document.createElement("p");
          none.className = "no-comments";
          none.textContent = "No comments yet. Say something nice!";
          commentsList.appendChild(none);
          return;
        }

        comments.forEach(c => {
          const row = document.createElement("div");
          row.className = "comment-row";
          const userLink = document.createElement("a");
          userLink.className = "comment-user";
          userLink.href = `/profile?id=${encodeURIComponent(c.userId)}`;
          userLink.textContent = c.username;
          const bodySpan = document.createElement("span");
          bodySpan.textContent = c.body;
          const timeSpan = document.createElement("span");
          timeSpan.className = "comment-time";
          timeSpan.textContent = new Date(c.createdAt).toLocaleString();
          row.appendChild(userLink);
          row.appendChild(bodySpan);
          row.appendChild(timeSpan);
          commentsList.appendChild(row);
        });
      }

      commentToggle.onclick = async () => {
        const showing = commentsBox.style.display !== "none";
        commentsBox.style.display = showing ? "none" : "block";
        if (!showing && !loaded) {
          loaded = true;
          await loadComments();
        }
      };

      commentForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const text = commentInput.value.trim();
        if (!text) return;

        await fetch(`${API}/comment`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ postId: post.postId, body: text })
        });

        commentInput.value = "";
        await loadComments();
        const countMatch = commentToggle.textContent.match(/\d+/);
        const newCount = (countMatch ? parseInt(countMatch[0], 10) : 0) + 1;
        commentToggle.textContent = `💬 ${newCount} comments`;
      });

      body.appendChild(commentsBox);
      card.appendChild(body);
      return card;
    }

    // ===== NEW POST =====
    document.getElementById("newPostForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const title = document.getElementById("postTitle").value.trim();
      const text = document.getElementById("postBody").value.trim();
      const fileInput = document.getElementById("postMedia");

      if (!title && !text && !fileInput.files[0]) {
        alert("Write something or attach a file first!");
        return;
      }

      const formData = new FormData();
      formData.append("title", title);
      formData.append("body", text);
      if (fileInput.files[0]) formData.append("media", fileInput.files[0]);

      const res = await fetch(`${API}/posts`, {
        method: "POST",
        credentials: "include",
        body: formData,
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(err.message || "Couldn't post that.");
        return;
      }

      document.getElementById("newPostForm").reset();
      document.getElementById("postMediaFilename").textContent = "";
      loadFeed();
    });

    // ===== SEARCH =====
    async function executeGlobalSearch() {
      const q = document.getElementById("globalSearchInput").value;
      const res = await fetch(`${API}/search?username=${encodeURIComponent(q)}`, {
        credentials: "include"
      });
      const users = await res.json();
      const resultsDiv = document.getElementById("globalSearchResults");
      resultsDiv.innerHTML = "";

      users.forEach(u => {
        const p = document.createElement("p");
        const a = document.createElement("a");
        a.href = `/profile?id=${encodeURIComponent(u.id)}`;
        a.textContent = u.username;
        p.appendChild(a);
        resultsDiv.appendChild(p);
      });
    }

    document.querySelectorAll(".logout-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        await fetch(`${API}/logout`, { method: "POST", credentials: "include" });
        window.location.href = "/";
      });
    });

    loadMe();
    loadFeed();

    initFileDropzone(
      document.getElementById("postMediaDropzone"),
      document.getElementById("postMedia"),
      {
        onFileSelected: (file) => {
          document.getElementById("postMediaFilename").textContent = file ? `Selected: ${file.name}` : "";
        },
      }
    );
  </script>

  <%- include('partials/fx', { nonce }) %>

</body>

</html>
