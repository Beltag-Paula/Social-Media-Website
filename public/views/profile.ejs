<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <%- include('partials/nav', { active: 'profile', showAdminLink: false, nonce }) %>

  <div class="page">
    <div class="profile-banner image-dropzone" id="bannerDropzone" tabindex="0" role="button" aria-label="Change banner">
      <img id="bannerImg" src="/default-banner.svg" alt="Profile banner" />
      <div class="image-dropzone-overlay">
        <span class="dropzone-icon">🏞</span>
        <span class="dropzone-text">Drop or click to change banner</span>
      </div>
    </div>
    <input type="file" id="bannerInput" accept="image/*" title="Change banner" class="visually-hidden" />

    <div class="profile-header">
      <div class="avatar-wrap image-dropzone" id="avatarDropzone" tabindex="0" role="button" aria-label="Change avatar">
        <img id="avatarDisplay" class="avatar" src="/default-avatar.svg" alt="Avatar" />
        <div class="image-dropzone-overlay">
          <span class="dropzone-icon">🖼</span>
        </div>
      </div>
      <input type="file" id="avatarInput" accept="image/*" title="Change avatar" class="visually-hidden" />
      <h1 id="welcomeMessage"></h1>
      <button type="button" class="pink message-profile-btn hidden" id="messageProfileBtn">💬 Message</button>
    </div>

    <div class="module field-block">
      <div class="module-title">About Me</div>
      <div class="module-body">
        <textarea id="bioText" rows="4"></textarea>
        <br /><br />
        <button id="saveBioBtn">Update Bio</button>
      </div>
    </div>

    <div class="module field-block">
      <div class="module-title">Posts</div>
      <div class="module-body">
        <div class="posts-grid" id="postsGrid">
          <p class="no-posts">Loading posts...</p>
        </div>
        <div class="profile-posts-footer">
          <button class="ghost view-all-btn js-hidden" id="togglePostsBtn" type="button">
            <span id="togglePostsIcon">+</span> <span id="togglePostsLabel">View all posts</span>
          </button>
        </div>
      </div>
    </div>

    <button class="pink" id="followBtn">Follow / Unfollow ★</button>
    <br /><br />

    <div class="module blue field-block">
      <div class="module-title">Intro Video</div>
      <div class="module-body">
        <video id="profileVideo" width="100%" controls>
          <source id="videoSource" src="" type="video/mp4">
        </video>
        <p id="noVideoMsg">No video found.</p>
        <div class="upload-control">
          <div class="dropzone" id="videoDropzone" tabindex="0" role="button" aria-label="Attach an intro video">
            <span class="dropzone-icon">🎬</span>
            <p class="dropzone-text">Drag &amp; drop a video, or click to browse</p>
            <p class="dropzone-filename" id="videoFilename"></p>
          </div>
          <input type="file" id="videoInput" accept="video/*" class="visually-hidden" />
        </div>
      </div>
    </div>

    <div class="module field-block" id="galleryModule">
      <div class="module-title">Photo Gallery</div>
      <div class="module-body">
        <p class="gallery-hint">Every avatar, banner &amp; intro video ever uploaded here — click one for a full slideshow, or (on your own profile) reuse a photo.</p>
        <div class="gallery-grid" id="galleryGrid">
          <p class="no-posts">Loading gallery...</p>
        </div>
        <div class="profile-posts-footer">
          <button class="ghost view-all-btn js-hidden" id="toggleGalleryBtn" type="button">
            <span id="toggleGalleryIcon">+</span> <span id="toggleGalleryLabel">View full gallery</span>
          </button>
        </div>
      </div>
    </div>

    <div class="people-columns">
      <div class="module field-block">
        <div class="module-title">Followers</div>
        <div class="module-body" id="followersList"></div>
      </div>
      <div class="module field-block">
        <div class="module-title">Following</div>
        <div class="module-body" id="followingList"></div>
      </div>
    </div>
  </div>

  <%- include('partials/dropzone', { nonce }) %>
  <%- include('partials/lightbox', { nonce }) %>
  <%- include('partials/chatWidget', { nonce }) %>
  <%- include('partials/chatSidebar', { nonce }) %>

  <script nonce="<%= nonce %>">
    const API_BASE = "/api/v1";

    // A gallery/avatar/banner reference in the DB doesn't guarantee the
    // underlying file still exists on disk (deleted upload, moved volume,
    // etc.) — without this, a missing file rendered as raw, unstyled alt
    // text instead of failing gracefully. Assigning to the .onerror
    // PROPERTY (not an inline onerror="" HTML attribute, which the CSP
    // in server.js blocks the same way it blocks inline <script> — see
    // nav.ejs for that exact fix) is what lets this run at all, and also
    // means re-fetching a profile (e.g. after a new upload) replaces the
    // handler instead of stacking a new one on the same reused <img> each time.
    function withImageFallback(imgEl, fallbackSrc) {
      imgEl.onerror = function () {
        imgEl.onerror = null;
        imgEl.src = fallbackSrc;
      };
    }
    let welcomeRevealed = false; // so the decrypt-reveal only fires on first load, not every refetch
    let isOwnProfile = true;

    // ===== PROFILE ID FROM URL =====
    const urlParams = new URLSearchParams(window.location.search);
    const profileUserId = urlParams.get("id"); // null = own profile

    if (profileUserId) {
      isOwnProfile = false;
      // Not your own profile: keep the avatar/banner photos visible, but
      // strip their upload interactivity (and drop the video upload box
      // entirely, same as before).
      document.querySelectorAll('.image-dropzone').forEach(el => {
        el.classList.remove('image-dropzone', 'drag-over');
        el.removeAttribute('tabindex');
        el.removeAttribute('role');
        el.removeAttribute('aria-label');
        el.style.cursor = 'default';
      });
      document.querySelectorAll('.image-dropzone-overlay').forEach(el => el.remove());
      document.querySelectorAll('.upload-control').forEach(el => el.remove());
      Array.from(document.querySelectorAll('input[type="file"]')).forEach(el => el.remove());
      document.getElementById('saveBioBtn').remove();
      document.getElementById('followBtn').style.display = "inline-block";
      document.getElementById('messageProfileBtn').classList.remove('hidden');
    } else {
      document.getElementById('followBtn').remove();
    }

    // ===== WHO AM I (drives the admin nav link + "don't message yourself") =====
    let myId = null;
    async function loadMe() {
      try {
        const res = await fetch(`${API_BASE}/me`, { credentials: "include" });
        if (!res.ok) return;
        const me = await res.json();
        myId = me.id;
        if (me.isAdmin) document.getElementById("adminNavLink").classList.remove("hidden");
      } catch (e) { /* not logged in */ }
    }

    // ===== LOAD PROFILE =====
    async function fetchProfile() {
      const url = profileUserId
        ? `${API_BASE}/profile/${profileUserId}`
        : `${API_BASE}/profile/me`;

      const res = await fetch(url, { credentials: "include" });

      if (res.status === 401 || res.status === 403) {
        window.location.href = "/";
        return;
      }

      const data = await res.json();

      const welcomeEl = document.getElementById("welcomeMessage");
      welcomeEl.textContent = data.username;
      if (!welcomeRevealed && window.__fx) {
        welcomeRevealed = true;
        window.__fx.decryptReveal(welcomeEl, { duration: 700 }, () => window.__fx.startGlitch(welcomeEl));
      }

      document.getElementById("bioText").value = data.bio || "";

      if (data.avatarPath) {
        const avatarEl = document.getElementById("avatarDisplay");
        withImageFallback(avatarEl, "/default-avatar.svg");
        avatarEl.src = `/${data.avatarPath}`;
      }
      if (data.bannerPath) {
        const bannerEl = document.getElementById("bannerImg");
        withImageFallback(bannerEl, "/default-banner.svg");
        bannerEl.src = `/${data.bannerPath}`;
      }

      const videoEl = document.getElementById("profileVideo");
      const sourceEl = document.getElementById("videoSource");

      if (data.videoPath) {
        sourceEl.src = `/${data.videoPath}`;
        videoEl.load();
        document.getElementById("noVideoMsg").style.display = "none";
      }
    }

    // ===== UPLOAD =====
    async function uploadFile(input, field) {
      const file = input.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append(field, file);

      const res = await fetch(`${API_BASE}/profile/${field}`, {
        method: "POST",
        credentials: "include",
        body: formData,
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(err.message || "Upload failed");
        return;
      }

      fetchProfile();
      loadGallery();
    }

    if (document.getElementById("avatarInput"))
      document.getElementById("avatarInput").onchange = e => uploadFile(e.target, "avatar");
    if (document.getElementById("bannerInput"))
      document.getElementById("bannerInput").onchange = e => uploadFile(e.target, "banner");
    if (document.getElementById("videoInput"))
      document.getElementById("videoInput").onchange = e => uploadFile(e.target, "video");

    // ===== BIO =====
    if (document.getElementById("saveBioBtn"))
      document.getElementById("saveBioBtn").onclick = async () => {
        const bio = document.getElementById("bioText").value;

        await fetch(`${API_BASE}/profile/bio`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ bio }),
        });

        alert("Bio updated!");
      };

    // ===== FOLLOW SYSTEM =====
    if (document.getElementById("followBtn"))
      document.getElementById("followBtn").onclick = async () => {
        if (!profileUserId) return;

        const res = await fetch(`${API_BASE}/follow`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ userId: profileUserId }),
        });

        const data = await res.json();
        alert(data.following ? "Now following!" : "Unfollowed");
        loadFollowers(profileUserId);
      };

    // ===== MESSAGE BUTTON (opens the shared chat widget on this person) =====
    document.getElementById("messageProfileBtn").addEventListener("click", () => {
      const nameEl = document.getElementById("welcomeMessage");
      const username = nameEl ? nameEl.textContent : "them";
      if (typeof window.openChatWith === "function") {
        window.openChatWith(parseInt(profileUserId, 10), username);
      }
    });

    // Built with textContent, not innerHTML, so a malicious username can't
    // inject a script that runs on whoever views this profile.
    function renderPersonRow(container, user) {
      const a = document.createElement("a");
      a.href = `/profile?id=${encodeURIComponent(user.id)}`;
      a.textContent = user.username;
      container.appendChild(a);
    }

    async function loadFollowers(userId) {
      const res = await fetch(`${API_BASE}/followers/${userId}`, { credentials: "include" });
      const data = await res.json();
      const container = document.getElementById("followersList");
      container.innerHTML = "";
      if (data.length === 0) { container.innerHTML = "<p class='no-comments'>No followers yet.</p>"; return; }
      data.forEach(user => renderPersonRow(container, user));
    }

    async function loadFollowing(userId) {
      const res = await fetch(`${API_BASE}/following/${userId}`, { credentials: "include" });
      const data = await res.json();
      const container = document.getElementById("followingList");
      container.innerHTML = "";
      if (data.length === 0) { container.innerHTML = "<p class='no-comments'>Not following anyone yet.</p>"; return; }
      data.forEach(user => renderPersonRow(container, user));
    }

    // ===== POSTS =====
    const POSTS_PREVIEW_LIMIT = 3;
    let postsExpanded = false;
    let currentPostImages = []; // kept in sync with the grid, for the lightbox's prev/next

    // Built with createElement + textContent (not innerHTML), same as the
    // home feed, so a post's title/body can never inject a script.
    function renderPostPreview(post, imageIndex) {
      const card = document.createElement("div");
      card.className = "post-preview-card";

      if (post.title) {
        const title = document.createElement("p");
        title.className = "post-preview-title";
        title.textContent = post.title;
        card.appendChild(title);
      }

      if (post.mediaPath) {
        const isVideo = /\.(mp4|webm|mov)$/i.test(post.mediaPath);
        const media = document.createElement(isVideo ? "video" : "img");
        media.className = "post-preview-media";
        if (!isVideo) withImageFallback(media, "/default-image.svg");
        media.src = `/${post.mediaPath}`;
        if (isVideo) {
          media.controls = true;
        } else {
          media.alt = post.title || "Post image";
          media.style.cursor = "zoom-in";
          media.addEventListener("click", () => {
            window.__lightbox.open(currentPostImages, imageIndex);
          });
        }
        card.appendChild(media);
      }

      if (post.body) {
        const body = document.createElement("p");
        body.className = "post-preview-body";
        body.textContent = post.body;
        card.appendChild(body);
      }

      const meta = document.createElement("div");
      meta.className = "post-preview-meta";

      const date = document.createElement("span");
      date.textContent = new Date(post.createdAt).toLocaleDateString();
      meta.appendChild(date);

      const likes = document.createElement("span");
      likes.textContent = `♥ ${post.likeCount || 0}`;
      meta.appendChild(likes);

      const comments = document.createElement("span");
      comments.textContent = `💬 ${post.commentCount || 0}`;
      meta.appendChild(comments);

      card.appendChild(meta);
      return card;
    }

    async function loadPosts(userId, expandAll) {
      const grid = document.getElementById("postsGrid");
      const toggleBtn = document.getElementById("togglePostsBtn");
      const url = expandAll
        ? `${API_BASE}/posts/user/${userId}`
        : `${API_BASE}/posts/user/${userId}?limit=${POSTS_PREVIEW_LIMIT}`;

      const res = await fetch(url, { credentials: "include" });
      if (!res.ok) return;

      const posts = await res.json();
      grid.innerHTML = "";

      if (!Array.isArray(posts) || posts.length === 0) {
        grid.innerHTML = "<p class='no-posts'>No posts yet.</p>";
        toggleBtn.classList.add("js-hidden");
        return;
      }

      // Only images (not videos) go in the lightbox's set, in the same
      // order they appear on screen.
      currentPostImages = posts
        .filter(p => p.mediaPath && !/\.(mp4|webm|mov)$/i.test(p.mediaPath))
        .map(p => ({ src: `/${p.mediaPath}`, caption: p.title || "" }));

      let imageIndex = 0;
      posts.forEach(post => {
        const isImage = post.mediaPath && !/\.(mp4|webm|mov)$/i.test(post.mediaPath);
        grid.appendChild(renderPostPreview(post, isImage ? imageIndex : -1));
        if (isImage) imageIndex++;
      });

      // Only worth offering "view all" if there might be more than the preview shows.
      if (!expandAll && posts.length < POSTS_PREVIEW_LIMIT) {
        toggleBtn.classList.add("js-hidden");
      } else {
        toggleBtn.classList.remove("js-hidden");
      }

      document.getElementById("togglePostsIcon").textContent = expandAll ? "−" : "+";
      document.getElementById("togglePostsLabel").textContent = expandAll ? "Show less" : "View all posts";
    }

    document.getElementById("togglePostsBtn").addEventListener("click", async () => {
      postsExpanded = !postsExpanded;
      await loadPosts(profileUserId || "me", postsExpanded);
    });

    // ===== GALLERY =====
    // GALLERY FIX: past avatars/banners/intro videos used to be silently
    // orphaned the moment you replaced them — the file stayed on disk and
    // the DB row stayed in `media`, but nothing in the app ever pointed at
    // it again, so there was no way to see or reuse it.
    // /api/v1/profile/:id/gallery (backed by the media.role column) now
    // surfaces every one of them, images and videos alike.
    const ROLE_LABEL_IMAGE = { avatar: "Avatar", banner: "Banner", profile: "Old profile photo" };
    const GALLERY_PREVIEW_LIMIT = 5;
    let galleryItems = [];
    let galleryExpanded = false;

    function galleryItemLabel(item) {
      if (item.mediaType === 1) return item.role === "video" ? "Intro video" : "Old video";
      return ROLE_LABEL_IMAGE[item.role] || "Photo";
    }

    function renderGalleryTile(item, index, allItems) {
      const tile = document.createElement("div");
      tile.className = "gallery-tile";
      const isVideo = item.mediaType === 1;
      const label = galleryItemLabel(item);

      if (isVideo) {
        const video = document.createElement("video");
        video.src = `/${item.filePath}`;
        video.preload = "metadata"; // shows the first frame as a thumbnail without downloading/playing the whole thing
        video.muted = true;
        video.setAttribute("aria-label", label);
        tile.appendChild(video);

        const playIcon = document.createElement("span");
        playIcon.className = "gallery-tile-play";
        playIcon.textContent = "▶";
        playIcon.setAttribute("aria-hidden", "true");
        tile.appendChild(playIcon);
      } else {
        const img = document.createElement("img");
        const galleryFallback = item.role === "avatar" ? "/default-avatar.svg"
          : item.role === "banner" ? "/default-banner.svg"
          : "/default-image.svg";
        withImageFallback(img, galleryFallback);
        img.src = `/${item.filePath}`;
        img.alt = label;
        img.loading = "lazy";
        tile.appendChild(img);
      }

      const tag = document.createElement("span");
      tag.className = "gallery-tile-tag";
      tag.textContent = label;
      tile.appendChild(tag);

      tile.addEventListener("click", () => {
        const lightboxItems = allItems.map(i => ({
          src: `/${i.filePath}`,
          type: i.mediaType === 1 ? "video" : "image",
          caption: `${galleryItemLabel(i)} · ${new Date(i.createdAt).toLocaleDateString()}`,
        }));
        window.__lightbox.open(lightboxItems, index);
      });

      if (isOwnProfile) {
        const actions = document.createElement("div");
        actions.className = "gallery-tile-actions";

        if (isVideo) {
          const setVideoBtn = document.createElement("button");
          setVideoBtn.type = "button";
          setVideoBtn.textContent = "Set as intro video";
          setVideoBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            selectGalleryMedia("video", item.id);
          });
          actions.appendChild(setVideoBtn);
        } else {
          const setAvatarBtn = document.createElement("button");
          setAvatarBtn.type = "button";
          setAvatarBtn.textContent = "Set as avatar";
          setAvatarBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            selectGalleryMedia("avatar", item.id);
          });

          const setBannerBtn = document.createElement("button");
          setBannerBtn.type = "button";
          setBannerBtn.textContent = "Set as banner";
          setBannerBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            selectGalleryMedia("banner", item.id);
          });

          actions.appendChild(setAvatarBtn);
          actions.appendChild(setBannerBtn);
        }

        tile.appendChild(actions);
      }

      return tile;
    }

    async function selectGalleryMedia(kind, mediaId) {
      const res = await fetch(`${API_BASE}/profile/${kind}/select`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ mediaId }),
      });
      if (res.ok) {
        fetchProfile();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.message || "Couldn't update that.");
      }
    }

    function renderGalleryGrid() {
      const grid = document.getElementById("galleryGrid");
      const toggleBtn = document.getElementById("toggleGalleryBtn");
      grid.innerHTML = "";

      if (galleryItems.length === 0) {
        grid.innerHTML = "<p class='no-posts'>No photos or videos yet.</p>";
        toggleBtn.classList.add("js-hidden");
        return;
      }

      const visible = galleryExpanded ? galleryItems : galleryItems.slice(0, GALLERY_PREVIEW_LIMIT);
      visible.forEach((item, index) => grid.appendChild(renderGalleryTile(item, index, galleryItems)));

      if (galleryItems.length <= GALLERY_PREVIEW_LIMIT) {
        toggleBtn.classList.add("js-hidden");
      } else {
        toggleBtn.classList.remove("js-hidden");
      }
      document.getElementById("toggleGalleryIcon").textContent = galleryExpanded ? "−" : "+";
      document.getElementById("toggleGalleryLabel").textContent = galleryExpanded
        ? "Show less"
        : `View full gallery (${galleryItems.length})`;
    }

    document.getElementById("toggleGalleryBtn").addEventListener("click", () => {
      galleryExpanded = !galleryExpanded;
      renderGalleryGrid();
    });

    async function loadGallery() {
      const res = await fetch(`${API_BASE}/profile/${profileUserId || "me"}/gallery`, { credentials: "include" });
      if (!res.ok) return;
      const items = await res.json();
      galleryItems = Array.isArray(items) ? items : [];
      galleryExpanded = false;
      renderGalleryGrid();
    }

    async function executeGlobalSearch() {
      const q = document.getElementById("globalSearchInput").value;
      const res = await fetch(`${API_BASE}/search?username=${encodeURIComponent(q)}`, {
        credentials: "include"
      });
      const users = await res.json();
      const resultsDiv = document.getElementById("globalSearchResults");
      resultsDiv.innerHTML = "";
      users.forEach(u => {
        const p = document.createElement("p");
        renderPersonRow(p, u);
        resultsDiv.appendChild(p);
      });
    }

    // ===== LOGOUT =====
    document.querySelectorAll(".logout-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        await fetch(`${API_BASE}/logout`, { method: "POST", credentials: "include" });
        window.location.href = "/";
      });
    });

    // ===== INIT =====
    loadMe();
    fetchProfile();
    loadFollowers(profileUserId || "me");
    loadFollowing(profileUserId || "me");
    loadPosts(profileUserId || "me", false);
    loadGallery();

    // On someone else's profile the file inputs are removed and the
    // image-dropzone class/attrs are stripped (see above), so
    // initFileDropzone just no-ops here (inputEl will be null).
    initFileDropzone(document.getElementById("avatarDropzone"), document.getElementById("avatarInput"));
    initFileDropzone(document.getElementById("bannerDropzone"), document.getElementById("bannerInput"));
    initFileDropzone(
      document.getElementById("videoDropzone"),
      document.getElementById("videoInput"),
      {
        onFileSelected: (file) => {
          const label = document.getElementById("videoFilename");
          if (label) label.textContent = file ? `Selected: ${file.name}` : "";
        },
      }
    );
  </script>

  <%- include('partials/fx', { nonce }) %>
</body>

</html>
