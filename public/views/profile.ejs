<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <%- include('partials/nav', { active: 'profile', showAdminLink: false }) %>

  <div class="page">
    <div class="profile-banner image-dropzone" id="bannerDropzone" tabindex="0" role="button" aria-label="Change banner">
      <img id="bannerImg" src="/default-banner.jpg" alt="Profile banner" />
      <div class="image-dropzone-overlay">
        <span class="dropzone-icon">🏞</span>
        <span class="dropzone-text">Drop or click to change banner</span>
      </div>
    </div>
    <input type="file" id="bannerInput" accept="image/*" title="Change banner" class="visually-hidden" />

    <div class="profile-header">
      <div class="avatar-wrap image-dropzone" id="avatarDropzone" tabindex="0" role="button" aria-label="Change avatar">
        <img id="avatarDisplay" class="avatar" src="/default-avatar.png" alt="Avatar" />
        <div class="image-dropzone-overlay">
          <span class="dropzone-icon">🖼</span>
        </div>
      </div>
      <input type="file" id="avatarInput" accept="image/*" title="Change avatar" class="visually-hidden" />
      <h1 id="welcomeMessage"></h1>
    </div>

    <div class="module field-block">
      <div class="module-title">About Me</div>
      <div class="module-body">
        <textarea id="bioText" rows="4"></textarea>
        <br /><br />
        <button id="saveBioBtn">Update Bio</button>
      </div>
    </div>

    <div class="module field-block">
      <div class="module-title">Posts</div>
      <div class="module-body">
        <div class="posts-grid" id="postsGrid">
          <p class="no-posts">Loading posts...</p>
        </div>
        <div class="profile-posts-footer">
          <button class="ghost view-all-btn" id="togglePostsBtn" type="button" style="display:none;">
            <span id="togglePostsIcon">+</span> <span id="togglePostsLabel">View all posts</span>
          </button>
        </div>
      </div>
    </div>

    <button class="pink" id="followBtn">Follow / Unfollow ★</button>
    <br /><br />

    <div class="module blue field-block">
      <div class="module-title">Intro Video</div>
      <div class="module-body">
        <video id="profileVideo" width="100%" controls>
          <source id="videoSource" src="" type="video/mp4">
        </video>
        <p id="noVideoMsg">No video found.</p>
        <div class="upload-control">
          <div class="dropzone" id="videoDropzone" tabindex="0" role="button" aria-label="Attach an intro video">
            <span class="dropzone-icon">🎬</span>
            <p class="dropzone-text">Drag &amp; drop a video, or click to browse</p>
            <p class="dropzone-filename" id="videoFilename"></p>
          </div>
          <input type="file" id="videoInput" accept="video/*" class="visually-hidden" />
        </div>
      </div>
    </div>

    <div class="people-columns">
      <div class="module field-block">
        <div class="module-title">Followers</div>
        <div class="module-body" id="followersList"></div>
      </div>
      <div class="module field-block">
        <div class="module-title">Following</div>
        <div class="module-body" id="followingList"></div>
      </div>
    </div>
  </div>

  <%- include('partials/dropzone') %>

  <script>
    const API_BASE = "/api/v1";
    let welcomeRevealed = false; // so the decrypt-reveal only fires on first load, not every refetch

    // ===== PROFILE ID FROM URL =====
    const urlParams = new URLSearchParams(window.location.search);
    const profileUserId = urlParams.get("id"); // null = own profile

    if (profileUserId) {
      // Not your own profile: keep the avatar/banner photos visible, but
      // strip their upload interactivity (and drop the video upload box
      // entirely, same as before).
      document.querySelectorAll('.image-dropzone').forEach(el => {
        el.classList.remove('image-dropzone', 'drag-over');
        el.removeAttribute('tabindex');
        el.removeAttribute('role');
        el.removeAttribute('aria-label');
        el.style.cursor = 'default';
      });
      document.querySelectorAll('.image-dropzone-overlay').forEach(el => el.remove());
      document.querySelectorAll('.upload-control').forEach(el => el.remove());
      Array.from(document.querySelectorAll('input[type="file"]')).forEach(el => el.remove());
      document.getElementById('saveBioBtn').remove();
      document.getElementById('followBtn').style.display = "inline-block";
    } else {
      document.getElementById('followBtn').remove();
    }

    // ===== WHO AM I (drives the admin nav link) =====
    async function loadMe() {
      try {
        const res = await fetch(`${API_BASE}/me`, { credentials: "include" });
        if (!res.ok) return;
        const me = await res.json();
        if (me.isAdmin) document.getElementById("adminNavLink").style.display = "inline-block";
      } catch (e) { /* not logged in */ }
    }

    // ===== LOAD PROFILE =====
    async function fetchProfile() {
      const url = profileUserId
        ? `${API_BASE}/profile/${profileUserId}`
        : `${API_BASE}/profile/me`;

      const res = await fetch(url, { credentials: "include" });

      if (res.status === 401 || res.status === 403) {
        window.location.href = "/";
        return;
      }

      const data = await res.json();

      const welcomeEl = document.getElementById("welcomeMessage");
      welcomeEl.textContent = data.username;
      if (!welcomeRevealed && window.__fx) {
        welcomeRevealed = true;
        window.__fx.decryptReveal(welcomeEl, { duration: 700 }, () => window.__fx.startGlitch(welcomeEl));
      }

      document.getElementById("bioText").value = data.bio || "";

      if (data.avatarPath) document.getElementById("avatarDisplay").src = `/${data.avatarPath}`;
      if (data.bannerPath) document.getElementById("bannerImg").src = `/${data.bannerPath}`;

      const videoEl = document.getElementById("profileVideo");
      const sourceEl = document.getElementById("videoSource");

      if (data.videoPath) {
        sourceEl.src = `/${data.videoPath}`;
        videoEl.load();
        document.getElementById("noVideoMsg").style.display = "none";
      }
    }

    // ===== UPLOAD =====
    async function uploadFile(input, field) {
      const file = input.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append(field, file);

      const res = await fetch(`${API_BASE}/profile/${field}`, {
        method: "POST",
        credentials: "include",
        body: formData,
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(err.message || "Upload failed");
        return;
      }

      fetchProfile();
    }

    if (document.getElementById("avatarInput"))
      document.getElementById("avatarInput").onchange = e => uploadFile(e.target, "avatar");
    if (document.getElementById("bannerInput"))
      document.getElementById("bannerInput").onchange = e => uploadFile(e.target, "banner");
    if (document.getElementById("videoInput"))
      document.getElementById("videoInput").onchange = e => uploadFile(e.target, "video");

    // ===== BIO =====
    if (document.getElementById("saveBioBtn"))
      document.getElementById("saveBioBtn").onclick = async () => {
        const bio = document.getElementById("bioText").value;

        await fetch(`${API_BASE}/profile/bio`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ bio }),
        });

        alert("Bio updated!");
      };

    // ===== FOLLOW SYSTEM =====
    if (document.getElementById("followBtn"))
      document.getElementById("followBtn").onclick = async () => {
        if (!profileUserId) return;

        const res = await fetch(`${API_BASE}/follow`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ userId: profileUserId }),
        });

        const data = await res.json();
        alert(data.following ? "Now following!" : "Unfollowed");
        loadFollowers(profileUserId);
      };

    // Built with textContent, not innerHTML, so a malicious username can't
    // inject a script that runs on whoever views this profile.
    function renderPersonRow(container, user) {
      const a = document.createElement("a");
      a.href = `/profile?id=${encodeURIComponent(user.id)}`;
      a.textContent = user.username;
      container.appendChild(a);
    }

    async function loadFollowers(userId) {
      const res = await fetch(`${API_BASE}/followers/${userId}`, { credentials: "include" });
      const data = await res.json();
      const container = document.getElementById("followersList");
      container.innerHTML = "";
      if (data.length === 0) { container.innerHTML = "<p class='no-comments'>No followers yet.</p>"; return; }
      data.forEach(user => renderPersonRow(container, user));
    }

    async function loadFollowing(userId) {
      const res = await fetch(`${API_BASE}/following/${userId}`, { credentials: "include" });
      const data = await res.json();
      const container = document.getElementById("followingList");
      container.innerHTML = "";
      if (data.length === 0) { container.innerHTML = "<p class='no-comments'>Not following anyone yet.</p>"; return; }
      data.forEach(user => renderPersonRow(container, user));
    }

    // ===== POSTS =====
    const POSTS_PREVIEW_LIMIT = 3;
    let postsExpanded = false;

    // Built with createElement + textContent (not innerHTML), same as the
    // home feed, so a post's title/body can never inject a script.
    function renderPostPreview(post) {
      const card = document.createElement("div");
      card.className = "post-preview-card";

      if (post.title) {
        const title = document.createElement("p");
        title.className = "post-preview-title";
        title.textContent = post.title;
        card.appendChild(title);
      }

      if (post.mediaPath) {
        const isVideo = /\.(mp4|webm|mov)$/i.test(post.mediaPath);
        const media = document.createElement(isVideo ? "video" : "img");
        media.className = "post-preview-media";
        media.src = `/${post.mediaPath}`;
        if (isVideo) media.controls = true;
        else media.alt = "";
        card.appendChild(media);
      }

      if (post.body) {
        const body = document.createElement("p");
        body.className = "post-preview-body";
        body.textContent = post.body;
        card.appendChild(body);
      }

      const meta = document.createElement("div");
      meta.className = "post-preview-meta";

      const date = document.createElement("span");
      date.textContent = new Date(post.createdAt).toLocaleDateString();
      meta.appendChild(date);

      const likes = document.createElement("span");
      likes.textContent = `♥ ${post.likeCount || 0}`;
      meta.appendChild(likes);

      const comments = document.createElement("span");
      comments.textContent = `💬 ${post.commentCount || 0}`;
      meta.appendChild(comments);

      card.appendChild(meta);
      return card;
    }

    async function loadPosts(userId, expandAll) {
      const grid = document.getElementById("postsGrid");
      const toggleBtn = document.getElementById("togglePostsBtn");
      const url = expandAll
        ? `${API_BASE}/posts/user/${userId}`
        : `${API_BASE}/posts/user/${userId}?limit=${POSTS_PREVIEW_LIMIT}`;

      const res = await fetch(url, { credentials: "include" });
      if (!res.ok) return;

      const posts = await res.json();
      grid.innerHTML = "";

      if (!Array.isArray(posts) || posts.length === 0) {
        grid.innerHTML = "<p class='no-posts'>No posts yet.</p>";
        toggleBtn.style.display = "none";
        return;
      }

      posts.forEach(post => grid.appendChild(renderPostPreview(post)));

      // Only worth offering "view all" if there might be more than the preview shows.
      if (!expandAll && posts.length < POSTS_PREVIEW_LIMIT) {
        toggleBtn.style.display = "none";
      } else {
        toggleBtn.style.display = "inline-flex";
      }

      document.getElementById("togglePostsIcon").textContent = expandAll ? "−" : "+";
      document.getElementById("togglePostsLabel").textContent = expandAll ? "Show less" : "View all posts";
    }

    document.getElementById("togglePostsBtn").addEventListener("click", async () => {
      postsExpanded = !postsExpanded;
      await loadPosts(profileUserId || "me", postsExpanded);
    });

    async function executeGlobalSearch() {
      const q = document.getElementById("globalSearchInput").value;
      const res = await fetch(`${API_BASE}/search?username=${encodeURIComponent(q)}`, {
        credentials: "include"
      });
      const users = await res.json();
      const resultsDiv = document.getElementById("globalSearchResults");
      resultsDiv.innerHTML = "";
      users.forEach(u => {
        const p = document.createElement("p");
        renderPersonRow(p, u);
        resultsDiv.appendChild(p);
      });
    }

    // ===== LOGOUT =====
    document.querySelectorAll(".logout-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        await fetch(`${API_BASE}/logout`, { method: "POST", credentials: "include" });
        window.location.href = "/";
      });
    });

    // ===== INIT =====
    loadMe();
    fetchProfile();
    loadFollowers(profileUserId || "me");
    loadFollowing(profileUserId || "me");
    loadPosts(profileUserId || "me", false);

    // On someone else's profile the file inputs are removed and the
    // image-dropzone class/attrs are stripped (see above), so
    // initFileDropzone just no-ops here (inputEl will be null).
    initFileDropzone(document.getElementById("avatarDropzone"), document.getElementById("avatarInput"));
    initFileDropzone(document.getElementById("bannerDropzone"), document.getElementById("bannerInput"));
    initFileDropzone(
      document.getElementById("videoDropzone"),
      document.getElementById("videoInput"),
      {
        onFileSelected: (file) => {
          const label = document.getElementById("videoFilename");
          if (label) label.textContent = file ? `Selected: ${file.name}` : "";
        },
      }
    );
  </script>

  <%- include('partials/fx') %>
</body>

</html>
